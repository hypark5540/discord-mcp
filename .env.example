# Discord Developer Portal에서 발급한 Bot Token
DISCORD_TOKEN=replace-with-your-bot-token

# 안전을 위해 기본값은 false입니다. 메시지 전송/수정 도구를 쓰려면 true로 변경하세요.
DISCORD_ENABLE_WRITES=false

# 메시지 삭제는 쓰기보다 더 위험하므로 별도로 활성화해야 합니다.
DISCORD_ENABLE_DELETES=false

# allowlist 없이 봇이 볼 수 있는 모든 guild channel에 쓰려는 경우에만 명시적으로 true로 설정하세요.
DISCORD_ALLOW_UNRESTRICTED_WRITES=false

# 선택: 쉼표로 구분한 allowlist. 읽기 모드에서 비우면 봇이 접근 가능한 모든 서버/채널을 허용합니다.
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# 선택: MCP 응답 하나에 포함할 최대 문자 수 (기본 50000, 범위 1000~200000)
DISCORD_MAX_RESPONSE_CHARS=50000
